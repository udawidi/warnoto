{
  "name": "warnoto-pln",
  "version": "2.0.3",
  "description": "WARNOTO - Warehouse Intelligent Control for Transmission Operation - PT PLN UPT Surabaya",
  "private": true,
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/react": "^10.68.0",
    "@supabase/supabase-js": "^2.108.2",
    "@zxing/browser": "^0.2.1",
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "pdfjs-dist": "^6.0.227",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@vitejs/plugin-react": "^4.0.0",
    "tailwindcss": "^4.3.2",
    "vite": "^4.4.0"
  },
  "scripts": {
    "dev": "node --use-system-ca node_modules/vite/bin/vite.js",
    "dev:e2e": "vite --mode e2e --host localhost --port 4173 --strictPort",
    "build": "vite build",
    "build:staging": "vite build --mode staging",
    "preview": "vite preview",
    "test": "node --test \"tests/unit/*.test.mjs\" \"tests/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test:responsive": "playwright test tests/e2e/responsive.spec.js",
    "test:responsive:update": "playwright test tests/e2e/responsive.spec.js --update-snapshots",
    "test:e2e:report": "playwright show-report",
    "test:csp": "vite build && node tests/csp/run-csp-e2e.mjs"
  }
}
