# Salin file ini jadi ".env" lalu isi value asli (.env tidak ikut ke git)

VITE_GROQ_API_KEY=   # DEPRECATED: sudah tidak dipakai client, semua call-site AI kini lewat Edge Function ai-proxy (OpenRouter)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_COHERE_API_KEY=
VITE_OCRSPACE_API_KEY=   # OCR nameplate di "Cari Barang dengan Foto" → daftar gratis di https://ocr.space/ocrapi
VITE_SENTRY_DSN=   # Sentry error tracking (SaaS) → dsn dari project Sentry, kosongkan utk dev lokal

# Supabase Edge Function / WhatsApp Cloud API
# Set sebagai Supabase secrets, bukan Vite env frontend:
# npx supabase secrets set WHATSAPP_VERIFY_TOKEN=...
# npx supabase secrets set WHATSAPP_ACCESS_TOKEN=...
# npx supabase secrets set WHATSAPP_PHONE_NUMBER_ID=...
# npx supabase secrets set OPENROUTER_API_KEY=...
# npx supabase secrets set OPENROUTER_MODEL=deepseek/deepseek-chat
# npx supabase secrets set COHERE_API_KEY=...
# Google Drive Maturity evidence (Edge Function only; never prefix these VITE_):
# npx supabase secrets set GOOGLE_DRIVE_MATURITY_ROOT_ID=13FFto2pzVRLq4LBpRaJsIyGa2Bk5gaYD
# npx supabase secrets set GOOGLE_DRIVE_CLIENT_ID=...
# npx supabase secrets set GOOGLE_DRIVE_CLIENT_SECRET=...
# npx supabase secrets set GOOGLE_DRIVE_REFRESH_TOKEN=...
